<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Direct Dialpad"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialedNumber"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_filter_chip_outline"
        android:gravity="center"
        android:hint="Enter phone number"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Dialpad Grid -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:stretchColumns="*">

        <TableRow android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnKey1" android:text="1" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnKey2" android:text="2" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnKey3" android:text="3" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
        </TableRow>
        <TableRow android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnKey4" android:text="4" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnKey5" android:text="5" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnKey6" android:text="6" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
        </TableRow>
        <TableRow android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnKey7" android:text="7" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnKey8" android:text="8" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnKey9" android:text="9" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
        </TableRow>
        <TableRow>
            <Button android:id="@+id/btnKeyStar" android:text="*" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnKey0" android:text="0" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnKeyBackspace" android:text="⌫" style="?android:attr/borderlessButtonStyle" android:textSize="22sp" android:textColor="@color/badge_red" />
        </TableRow>
    </TableLayout>

    <!-- Call Triggers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialAudio"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/primary_emerald"
            android:text="📞 Audio Call"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDialVideo"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/blue_video"
            android:text="📹 Video Call"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
