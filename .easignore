# EAS Build ignore file
# This overrides .gitignore for EAS uploads

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios

firebase-service-account.json

# APK builds (local only)
*.apk

# Scratch / debug scripts
scratch_*.js
*.db
.env
.env.*

# Local-only screenshots (NOT *.png — assets PNGs are needed for build!)
phone_screen*.png
sunao_*.png
screen_app.png
